# Powerlevel10k instant prompt. Keep this near the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH=/usr/local/share/oh-my-zsh
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
export GITSTATUS_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/gitstatus"
mkdir -p "$ZSH_CACHE_DIR" "$GITSTATUS_CACHE_DIR"
ZSH_THEME="powerlevel10k/powerlevel10k"
zstyle ':omz:update' mode disabled

plugins=(
  git
  z
  sudo
  extract
  zsh-autosuggestions
  zsh-syntax-highlighting
  you-should-use
)
source "$ZSH/oh-my-zsh.sh"

# Accept the inline suggestion with Ctrl+/
bindkey '^_' autosuggest-accept
# Prefer shell history, then completion, when suggesting
export ZSH_AUTOSUGGEST_STRATEGY=(history completion)
# Show you-should-use reminders after command output
export YSU_MESSAGE_POSITION='after'

# Absent ~/.p10k.zsh makes the next interactive shell run `p10k configure`.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
